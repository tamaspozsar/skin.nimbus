<?xml version="1.0" encoding="UTF-8"?>
<window id="1112">
	<defaultcontrol always="true">100</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<depth>DepthDialog+</depth>
	<controls>
		<control type="group">
			<height>1000</height>
			<centertop>50%</centertop>
			<centerleft>50%</centerleft>
			<width>1200</width>
			<include content="DialogBackgroundCommons">
				<param name="header_label" value="Welcome to Nimbus Jellyfin" />
				<param name="header_id" value="1" />
			</include>
			<control type="textbox" id="9">
				<left>0</left>
				<top>100</top>
				<width>1200</width>
				<height>1000</height>
				<textcolor>darkgrey</textcolor>
				<font>font32_title</font>
				<label>Nimbus Jellyfin starts with a TV-friendly preset for Jellyfin for Kodi.[CR][CR]The home screen is reduced to Movies and TV Shows. Each section includes Continue Watching, Recently Added and a direct Browse row based on Kodi's native video library, which Jellyfin for Kodi keeps synchronized.[CR][CR]You can restore the full Nimbus home menu at any time from Skin settings » Main menu by disabling Jellyfin minimal home.[CR][CR]Views remain customizable and are remembered independently for movies, TV shows, seasons and episodes.</label>
				<autoscroll time="3000" delay="4000" repeat="5000">true</autoscroll>
			</control>
			<control type="button" id="100">
				<visible>!Skin.HasSetting(firsttimerun)</visible>
				<centerleft>50%</centerleft>
				<top>870</top>
				<width>300</width>
				<height>100</height>
				<label>OK</label>
				<font>font25_title</font>
				<textoffsetx>20</textoffsetx>
				<textoffsety>33</textoffsety>
				<onclick>Skin.Setbool(firsttimerun)</onclick>
				<onclick>back</onclick>
				<onclick>Skin.SetBool(JellyfinMinimalHome)</onclick>
				<align>center</align>
				<aligny>left</aligny>
				<texturefocus border="40" colordiffuse="$VAR[FocusColorTheme]">buttons/dialogbutton-fo.png</texturefocus>
				<texturenofocus border="40" colordiffuse="button_focus2">buttons/dialogbutton-nofo.png</texturenofocus>
			</control>
		</control>
	</controls>
</window>
