<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="movies">
    <name>Family</name>
    <match>all</match>
    <rule field="genre" operator="contains">
        <value>Family</value>
    </rule>
    <limit>20</limit>
    <order direction="descending">rating</order>
</smartplaylist>
