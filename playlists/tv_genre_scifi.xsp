<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="tvshows">
    <name>Sci-Fi</name>
    <match>one</match>
    <rule field="genre" operator="contains">
        <value>Science Fiction</value>
    </rule>
    <rule field="genre" operator="contains">
        <value>Sci-Fi</value>
    </rule>
    <limit>20</limit>
    <order direction="descending">rating</order>
</smartplaylist>
