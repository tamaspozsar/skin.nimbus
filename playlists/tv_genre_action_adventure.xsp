<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="tvshows">
    <name>Action &amp; Adventure</name>
    <match>one</match>
    <rule field="genre" operator="contains">
        <value>Action</value>
    </rule>
    <rule field="genre" operator="contains">
        <value>Adventure</value>
    </rule>
    <limit>20</limit>
    <order direction="descending">rating</order>
</smartplaylist>
